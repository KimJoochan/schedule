<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-[#f5f5f5] min-h-screen flex items-center justify-center font-sans antialiased">
    <div class="bg-white p-8 rounded-xl shadow-[0_4px_12px_rgba(0,0,0,0.1)] max-w-sm w-full mx-4 text-center border border-gray-100">
        <p class="text-sm text-gray-500 mb-8">서비스 이용을 위해 로그인이 필요합니다.</p>
        
        <button id="kakao-login-btn" class="w-full py-3 px-4 bg-[#1976d2] hover:bg-[#1565c0] text-white font-medium rounded-md shadow-[0_2px_4px_rgba(0,0,0,0.2)] hover:shadow-[0_4px_8px_rgba(0,0,0,0.3)] transition-all duration-200 ease-in-out focus:outline-none uppercase tracking-wide text-sm">
            로그인
        </button>
        
    </div>

    <script>
    document.getElementById('kakao-login-btn').addEventListener('click', () => {
        // 1. 명세서에 나와있는 기본 주소 (Base URL)
        const baseUrl = "https://auth.ziongroup.net/oauth/authorize"; 
        
        // 2. 명세서의 Parameters 채우기
        const client_id = "162bff30e9424707bc47926f18bea77a";
        const redirect_uri = window.location.origin + "/login_back";
        const response_type = "code";
        const state = "state";
        const encode_state = "true";

        // 3. 쿼리 스트링 문자열로 조립하기
        const targetUrl = `${baseUrl}?client_id=${client_id}&redirect_uri=${encodeURIComponent(redirect_uri)}&response_type=${response_type}&state=${state}&encode_state=${encode_state}`;

        // 4. 해당 주소로 이동 (페이지 전환)
        window.location.href = targetUrl;
    });
    </script>
</body>
</html>