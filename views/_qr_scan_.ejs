<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>QR Auth & Checklist System (가상 시뮬레이터)</title>
    <script src="https://cdn.jsdelivr.net/npm/jsqr@1.4.0/dist/jsQR.min.js"></script>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-[#f5f5f5] min-h-screen flex items-center justify-center font-sans antialiased py-10">

    <div class="bg-white p-6 sm:p-8 rounded-xl shadow-[0_4px_12px_rgba(0,0,0,0.08)] max-w-md w-full mx-4 border border-gray-100">
        
        <div class="text-center mb-6">
            <h2 class="text-2xl font-semibold text-gray-800 tracking-tight">QR 인증 및 트래킹 시스템</h2>
            <p class="text-xs text-orange-500 font-bold mt-1 uppercase tracking-wider">⚠️ 가상 QR 스캔 테스트 모드</p>
            <div class="w-full h-[1px] bg-gray-100 mt-4"></div>
        </div>

        <div class="flex flex-col items-center justify-center min-h-[260px] bg-gray-50 rounded-lg p-4 border border-gray-200/60 relative overflow-hidden">
            <div id="loadingMessage" class="text-sm font-medium text-gray-500 animate-pulse hidden">
                🎥 카메라 권한 요청 중...
            </div>
            
            <canvas id="canvas" class="w-full max-w-[360px] border border-gray-300 rounded-md shadow-sm bg-white" hidden></canvas>
            
            <div id="result" class="mt-4 text-sm font-semibold text-blue-600 tracking-wide">
                스캔 대기 중...
            </div>
        </div>

        <div class="mt-6 flex flex-col gap-3">
            <button class="w-full py-3 px-4 bg-[#1976d2] hover:bg-[#1565c0] text-white font-semibold text-sm rounded-md shadow-[0_1px_3px_rgba(0,0,0,0.1)] hover:shadow-[0_4px_8px_rgba(0,0,0,0.2)] transition-all duration-200 ease-in-out uppercase tracking-wider focus:outline-none" onclick="startCamera()">
                가상 QR 코드 로드하기
            </button>
        </div>
        <div class="mt-3 flex flex-col gap-3">
            <button class="w-full py-3 px-4 bg-[#455a64] hover:bg-[#37474f] text-white font-semibold text-sm rounded-md shadow-[0_1px_3px_rgba(0,0,0,0.1)] hover:shadow-[0_4px_8px_rgba(0,0,0,0.2)] transition-all duration-200 ease-in-out uppercase tracking-wider focus:outline-none" onclick="confirmSatus()">
                출결 상태 확인하기
            </button>
        </div>
    </div>

    <script>
        function confirmSatus(){
            location.href = '/my_status';
        }

        const canvasElement = document.getElementById("canvas");
        const canvas = canvasElement.getContext("2d", { willReadFrequently: true });
        const loadingMessage = document.getElementById("loadingMessage");
        const resultDiv = document.getElementById("result");

        const MY_KAKAO_TOKEN = "KAKAOTALK_ACCESS_TOKEN_SAMPLE_12345";
        let isScanning = true;

        // 테스트용 오픈소스 가상 QR 코드 이미지 (접속 시 /qr_scan 구조의 명세를 담은 샘플)
        const sampleQrImageUrl = "https://api.qrserver.com/v1/create-qr-code/?size=400x400&data=https://auth.ziongroup.net/attendance/verify?theme_id=999";
        const qrImage = new Image();
        qrImage.crossOrigin = "Anonymous"; // jsqR의 getImageData CORS 보안 제약 우회 설정

        // [동작 실행] 페이지 로드 시 가상 카메라 구동
        startCamera();

        // 가상 QR 구동 함수
        function startCamera() {
            isScanning = true;
            resultDiv.innerText = "가상 QR 이미지 분석 중...";
            resultDiv.style.color = "#2563eb";
            
            // 이미지 로드가 완료되면 캔버스 렌더링 및 디코딩 루프 시작
            qrImage.onload = function() {
                loadingMessage.hidden = true;
                canvasElement.hidden = false;

                // 캔버스 크기를 가상 이미지 규격에 동기화
                canvasElement.width = 400;
                canvasElement.height = 400;
                
                // 프레임 추적 틱 가동
                requestAnimationFrame(tick);
            };
            
            // 이미지 소스 공급
            qrImage.src = sampleQrImageUrl;
        }

        // 프레임 추적 및 QR 디코딩 (가상 이미지 타겟 렌더링)
        function tick() {
            if (!isScanning) return;

            // 캔버스에 가상 QR 이미지를 정적으로 드로잉
            canvas.drawImage(qrImage, 0, 0, canvasElement.width, canvasElement.height);
            
            try {
                const imageData = canvas.getImageData(0, 0, canvasElement.width, canvasElement.height);
                const code = jsQR(imageData.data, imageData.width, imageData.height, {
                    inversionAttempts: "dontInvert",
                });

                if (code) {
                    isScanning = false;
                    // 디바운싱 제어 확보 후 하이라이트 박스 및 API 통신단 바인딩
                    drawSuccessBox(code.location);
                    processRedirect(code.data);
                    return;
                }
            } catch (e) {
                console.error("CORS 또는 이미지 데이터 획득 실패:", e);
                resultDiv.innerText = "이미지 분석 오류";
                resultDiv.style.color = "#dc2626";
                return;
            }

            if (isScanning) {
                requestAnimationFrame(tick);
            }
        }

        // 스캔 성공 타겟 하이라이트 박스 드로잉
        function drawSuccessBox(loc) {
            canvas.beginPath();
            canvas.moveTo(loc.topLeftCorner.x, loc.topLeftCorner.y);
            canvas.lineTo(loc.topRightCorner.x, loc.topRightCorner.y);
            canvas.lineTo(loc.bottomRightCorner.x, loc.bottomRightCorner.y);
            canvas.lineTo(loc.bottomLeftCorner.x, loc.bottomLeftCorner.y);
            canvas.closePath();
            canvas.lineWidth = 8; // 고해상도 가상 이미지 대비 보정 선폭
            canvas.strokeStyle = "#ef4444";
            canvas.stroke();
        }

        // 비동기 데이터 전송 처리 로직
        async function processRedirect(scannedUrl) {
            try {
                resultDiv.innerText = `스캔 데이터 인식 완료! 전송 중...`;
                resultDiv.style.color = "#ea580c";

                const formData = new FormData();
                formData.append("target_url", scannedUrl); 
                formData.append("kakao_token", MY_KAKAO_TOKEN); 

                const response = await fetch("https://httpbin.org/post", {
                    method: "POST",
                    body: formData
                });

                if (response.ok) {
                    const res = await response.json();
                    console.log("가상 통신 성공 데이터:", res);
                    
                    // 파싱된 가상 QR 내부 데이터 정보 노출
                    resultDiv.innerHTML = `인증 성공!<br><span class="text-xs text-gray-500 font-mono">${scannedUrl}</span>`;
                    resultDiv.style.color = "#16a34a";
                } else {
                    throw new Error("서버 에러코드: " + response.status);
                }
            } catch (e) {
                console.error("전송 오류:", e);
                resultDiv.innerText = "처리 실패: " + e.message;
                resultDiv.style.color = "#dc2626";
            }
        }
    </script>
</body>
</html>