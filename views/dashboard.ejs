<script>
    const ZION_TOKEN = "<%= token %>";
    console.log(ZION_TOKEN);
    // 페이지가 로드되면 서버 API를 호출해서 데이터를 가져옴
    window.addEventListener('DOMContentLoaded', async () => {
       // 프론트엔드 HTML / EJS 안의 script 태그 내용
        try {
            // 🔥 외부 주소가 아닌 '내 서버의 API'로 요청을 보냅니다.
            // 브라우저가 세션 쿠키를 자동으로 동반하므로 headers에 토큰을 직접 안 넣어도 됩니다!
            const res = await fetch('/api/user-profile', {
                method: 'GET'
            });

            if (!res.ok) {
                throw new Error(`서버 에러: ${res.status}`);
            }

            // 내 서버가 전달해준 JSON 데이터를 파싱합니다.
            const data = await res.json();
            console.log("드디어 안전하게 가져온 유저 데이터:", data);
            // 성공 데이터 활용 예시:
            // document.getElementById('name').innerText = data.NAME;
        } catch (err) {
            console.error("데이터 가져오기 실패", err);
        }
    });
</script>